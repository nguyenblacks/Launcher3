<?xml version="1.0" encoding="utf-8"?>
<!--
  M3 / Monet QSB (Quick Search Bar) pill background.
  - Pure pill shape (100dp corner radius = always circular ends)
  - Translucent frosted-glass Monet surface tint (#32FFFFFF)
  - Subtle Monet-tinted stroke (#30FFFFFF)
  - Ripple feedback on tap
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="@dimen/qsb_shadow_margin"
    android:insetLeft="@dimen/qsb_shadow_margin"
    android:insetRight="@dimen/qsb_shadow_margin"
    android:insetTop="@dimen/qsb_shadow_margin">
    <ripple android:color="#20FFFFFF">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF" />
                <corners android:radius="100dp" />
            </shape>
        </item>
        <!-- M3 Monet translucent pill surface -->
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#32FFFFFF" />
                <stroke
                    android:width="1dp"
                    android:color="#2AFFFFFF" />
                <corners android:radius="100dp" />
            </shape>
        </item>
    </ripple>
</inset>