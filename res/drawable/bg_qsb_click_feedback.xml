<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid pill background for the Quick Search Bar.
  - Pure pill shape (100dp corner radius = always circular ends)
  - Opaque light/dark theme surface
  - Ripple feedback on tap
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="@dimen/qsb_shadow_margin"
    android:insetLeft="@dimen/qsb_shadow_margin"
    android:insetRight="@dimen/qsb_shadow_margin"
    android:insetTop="@dimen/qsb_shadow_margin">
    <ripple android:color="#20FFFFFF">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF" />
                <corners android:radius="100dp" />
            </shape>
        </item>
        <!-- Theme surface remains opaque in both light and dark themes. -->
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/popupColorPrimary" />
                <stroke
                    android:width="1dp"
                    android:color="?attr/popupColorTertiary" />
                <corners android:radius="100dp" />
            </shape>
        </item>
    </ripple>
</inset>