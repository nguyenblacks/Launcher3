<?xml version="1.0" encoding="utf-8"?>
<!--
    Go Launcher 3 – Widgets Bottom Sheet
    Material 3 draggable bottom sheet — no gradient scrim, solid surface.
    The drag-to-dismiss is handled by SwipeDetector in WidgetsBottomSheet.java.
-->
<com.android.launcher3.widget.WidgetsBottomSheet
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_bottom_sheet_m3"
    android:elevation="16dp"
    android:layout_gravity="bottom"
    android:theme="?attr/widgetsTheme">

    <!-- M3 Drag Handle — wider and more prominent for discoverability -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Sheet title: app name -->
    <TextView
        style="@style/TextTitle"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp" />

    <!-- Subtitle: tap to add hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="16dp"
        android:fontFamily="sans-serif"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:text="@string/long_press_widget_to_add" />

    <!-- Widget list — scrollable row of widget previews -->
    <include layout="@layout/widgets_scroll_container"
        android:id="@+id/widgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Nav bar background (pre-Oreo only) -->
    <View
        android:id="@+id/nav_bar_bg"
        android:background="?attr/bottomSheetNavBarColor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:focusable="false" />

</com.android.launcher3.widget.WidgetsBottomSheet>